# Copy to .env for local npm development. These values are local placeholders, not production secrets.
# Docker Compose injects its own service hostnames and does not require this file.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL and Redis from `docker compose up -d postgres redis`
DATABASE_URL=postgres://fielddesk:fielddesk@localhost:5432/fielddesk
REDIS_URL=redis://localhost:6379/0

# At least 32 characters. Replace this placeholder for any shared environment.
JWT_SECRET=dev-only-change-me-not-for-production-use-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY=false

# Comma-separated browser origins. The Vite dev server proxies /api, so cookies stay same-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

LOG_LEVEL=info
SEED_ON_START=false

MAX_UPLOAD_BYTES=5242880
DEFAULT_STORAGE_LIMIT_BYTES=52428800
UPLOAD_DIR=uploads

LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=1 minute
EVENT_RATE_MAX=30
EVENT_RATE_WINDOW=1 minute

NOTIFY_ATTEMPTS=5
NOTIFY_BACKOFF_MS=1000
QUEUE_NAME=notifications
